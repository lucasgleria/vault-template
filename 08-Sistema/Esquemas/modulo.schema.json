{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vault — modulo.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "module_slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "module_version": {
      "type": "string",
      "minLength": 1
    },
    "module_note_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^n_[0-9a-f]{32}$"
    },
    "core_schema_min": {
      "const": 2
    },
    "purpose": {},
    "exclusions": {},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^n_[0-9a-f]{32}$"
      },
      "uniqueItems": true
    },
    "entities_reused": {
      "type": "array",
      "items": {
        "enum": [
          "captura",
          "tarefa",
          "projeto",
          "area",
          "objetivo",
          "rotina",
          "conhecimento",
          "recurso",
          "registro",
          "decisao",
          "perfil",
          "fonte",
          "modulo"
        ]
      },
      "uniqueItems": true
    },
    "fields": {
      "type": "object"
    },
    "routines_possible": {},
    "required_capabilities": {},
    "optional_capabilities": {},
    "permissions_granted_by_manifest": {
      "type": "array",
      "maxItems": 0
    },
    "activation_authorization_ref": {},
    "acceptance": {},
    "migration": {},
    "deactivation": {},
    "review_after_days": {}
  },
  "required": [
    "schema_version",
    "module_slug",
    "module_version",
    "module_note_id",
    "core_schema_min",
    "purpose",
    "exclusions",
    "dependencies",
    "entities_reused",
    "fields",
    "routines_possible",
    "required_capabilities",
    "optional_capabilities",
    "permissions_granted_by_manifest",
    "activation_authorization_ref",
    "acceptance",
    "migration",
    "deactivation",
    "review_after_days"
  ],
  "additionalProperties": false
}
